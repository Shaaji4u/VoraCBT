APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=voracbt_local
DB_USERNAME=root
DB_PASSWORD=

QUEUE_DRIVER=database
CACHE_DRIVER=file

JWT_SECRET=local-dev-secret
SMS_OAUTH_CLIENT_ID=dev-client
SMS_OAUTH_CLIENT_SECRET=dev-secret

API_RATE_LIMIT=120
API_RATE_LIMIT_WINDOW=60

RETENTION_SECURITY_LOG_DAYS=180
RETENTION_INTEGRATION_LOG_DAYS=180
RETENTION_IDENTITY_LOG_DAYS=365
RETENTION_PROCTORING_LOG_DAYS=90
RETENTION_CHECKPOINT_DAYS=30
RETENTION_SNAPSHOT_DAYS=365
