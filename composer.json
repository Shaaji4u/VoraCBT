{
    "name": "cbt/enterprise-platform",
    "description": "CBT Enterprise Platform Infrastructure",
    "type": "project",
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^6.0",
        "nikic/fast-route": "^1.3",
        "vlucas/phpdotenv": "^5.5",
        "ramsey/uuid": "^4.7",
        "symfony/validator": "^6.3",
        "predis/predis": "^2.2",
        "doctrine/dbal": "^3.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "authors": [
        {
            "name": "Infrastructure Agent",
            "email": "infra@cbt.local"
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        },
        "audit": {
            "ignore": {
                "firebase/php-jwt": "*"
            }
        }
    }
}
