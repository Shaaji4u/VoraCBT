# Application Settings
APP_NAME="CBT Enterprise Platform"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# System Mode: standalone | connected
SYSTEM_MODE=standalone

# Database Settings
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cbt_platform
DB_USERNAME=root
DB_PASSWORD=

# Caching Configuration
# Drivers: file, database, redis
CACHE_DRIVER=file

# Queue Configuration
# Drivers: sync, database, redis
QUEUE_CONNECTION=sync

# Redis Configuration (Used if CACHE_DRIVER=redis or QUEUE_CONNECTION=redis)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=changeme_in_production
JWT_ALGO=HS256
JWT_LIFETIME=900
JWT_REFRESH_LIFETIME=86400

# SMS Integration (Required if SYSTEM_MODE=connected)
SMS_API_BASE_URL=
SMS_CLIENT_ID=
SMS_CLIENT_SECRET=

# File Storage
# Drivers: local, s3
FILESYSTEM_DRIVER=local
UPLOAD_PATH=/storage/uploads

# AWS S3 Configuration (Used if FILESYSTEM_DRIVER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

API_RATE_LIMIT=120
API_RATE_LIMIT_WINDOW=60

RETENTION_SECURITY_LOG_DAYS=180
RETENTION_INTEGRATION_LOG_DAYS=180
RETENTION_IDENTITY_LOG_DAYS=365
RETENTION_PROCTORING_LOG_DAYS=90
RETENTION_CHECKPOINT_DAYS=30
RETENTION_SNAPSHOT_DAYS=365
